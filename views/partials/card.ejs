<a class="card" href="/properties/<%= p.id %>"><img src="<%= p.images[0] || 'https://picsum.photos/800/500' %>" alt="">
<div class="pad"><span class="tag"><%= p.status==='rent'?'For rent':'For sale' %></span><h3><%= p.title %></h3>
<p class="muted"><%= p.city %> · <%= p.type %></p><p class="meta"><% if (p.bedrooms) { %><%= p.bedrooms %> bed · <% } %><% if (p.bathrooms) { %><%= p.bathrooms %> bath · <% } %><%= p.area %> m²</p>
<p class="price"><%= fmt(p.price) %><%= p.status==='rent'?' /month':'' %></p></div></a>
